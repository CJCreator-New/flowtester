.qa-report/
.qa-runner-report/
.qa-tunnel-report/
.qa-compare/
.qa-cache/
.qa-hub-storage/
.tmp-*/

# Tooling
.kilo/
.playwright-mcp/
.claude/
.scratch/

# Benchmark runs (scripts/benchmark.ts)
.benchmark/

# built for Vercel (scripts/vercel-output.mjs)
/public
