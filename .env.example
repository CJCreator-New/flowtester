# ==============================================================================
# QA Tool - Local Docker Environment Configuration
# ==============================================================================

# PostgreSQL
POSTGRES_USER=qahub
POSTGRES_PASSWORD=qahub_secret
POSTGRES_DB=qa_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qahub:qahub_secret@localhost:5432/qa_hub?schema=public

# MinIO (S3-compatible Object Storage for Evidence)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=qa-evidence
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/qa-evidence

# Report Hub API
HUB_PORT=4000
# The QA Tool passes Studio's /api/v1/* calls on to this Hub
HUB_API_URL=http://localhost:4000

# The QA Tool (pnpm start / docker compose): the Wizard at /, QA Flow Studio at /studio/, and the API
RUNNER_PORT=3001

# Only for working on Studio with hot reload (pnpm dev:web)
VITE_HUB_API_URL=http://localhost:4000
VITE_RUNNER_STREAM_URL=http://localhost:3001
