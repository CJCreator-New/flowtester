{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@qa/wizard...\"",
  "buildCommand": "pnpm --filter @qa/types run build && pnpm --filter @qa/wizard run build",
  "outputDirectory": "packages/wizard/dist",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
